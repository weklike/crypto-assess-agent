# 复制为 .env 后填写（cp -n .env.example .env）；.env 已被 git 忽略，不要提交。
# 应用在 local / eval profile 下读取本文件；compose 需要 --env-file .env：
#   docker compose --env-file .env -f deploy/compose.yaml --profile core up -d

# 大模型：OpenAI 兼容接口，映射到 spring.ai.openai.*
# LLM_BASE_URL 留空时使用 OpenAI 官方地址；LLM_API_KEY 留空时应用能启动，但调用会被服务端拒绝，/api/health 报 llm-config DOWN
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

# Embedding：Ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_BATCH_SIZE=16
EMBED_TIMEOUT=60s

# 重排：TEI
RERANK_BASE_URL=http://localhost:8081
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT=180s
# compose 用：TEI 加载的模型（可改为 tei-data 卷内的快照目录以离线启动）、预热批大小、下载镜像站
TEI_MODEL_ID=BAAI/bge-reranker-v2-m3
TEI_MAX_BATCH_TOKENS=4096
HF_ENDPOINT=https://huggingface.co

# MySQL（compose 用同样的用户名和密码初始化数据库）
MYSQL_URL=jdbc:mysql://localhost:3306/crypto_assess
MYSQL_USER=crypto_assess
MYSQL_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ES_URIS=http://localhost:9200

# 知识库：规范化标准所在目录（导入接口只接受该目录下的文件名）
KB_NORMALIZED_DIR=data/normalized

# 问答：模型调用超时；拒答阈值（重排分，T09 校准前为占位值）
QA_TIMEOUT=60s
QA_REFUSE_THRESHOLD=0.1

# MCP 与管理接口的 API Key：客户端:密钥:scope1,scope2;…（scope：kb:read、rules:read、admin；密钥至少 12 位）
# 为空时 /mcp 与导入、重建索引接口全部拒绝。请求头 X-API-Key 或 Authorization: Bearer <密钥>
MCP_API_KEYS=

# Redis 限流（/api/qa、/api/assessments/*/analyze）与向量缓存
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=0.2
EMBED_CACHE_ENABLED=true
EMBED_CACHE_TTL=30d

# 入库方式：sync（默认）或 kafka（需要 mq profile）
INGEST_MODE=sync
KAFKA_BOOTSTRAP=localhost:9092

# 调用链追踪（可选）：Langfuse 的 OTLP 地址（…/api/public/otel）与密钥；TRACING_ENABLED=true 才会采集
TRACING_ENABLED=false
LANGFUSE_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 模型单价（元/百万 tokens）：模型:输入单价:输出单价;…  用于 llm_call.cost_cny 与评测报告
PRICE_TABLE=

# 模型调用超时：业务超时以 QA_TIMEOUT / JUDGE_TIMEOUT 为准；LLM_HTTP_TIMEOUT 是 SDK 的 HTTP 兜底上限，应大于前两者
JUDGE_TIMEOUT=240s
LLM_HTTP_TIMEOUT=540s

# 题库问答评测（--eval.suite=qa）只用本地 Ollama 模型，题库不外发；需事先 ollama pull，评测时不自动拉取
EVAL_QA_MODEL=qwen2.5:3b
# 允许的 Ollama 主机名（逗号分隔），默认 localhost,127.0.0.1,::1,ollama；*-cloud 模型一律拒绝
# EVAL_QA_ALLOWED_HOSTS=localhost,127.0.0.1,::1,ollama
