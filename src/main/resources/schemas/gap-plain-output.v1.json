{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["gaps"],
  "properties": {
    "gaps": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "clause_ref", "judgment", "reason"],
        "properties": {
          "object": { "type": "string", "maxLength": 64 },
          "clause_ref": { "type": "string", "maxLength": 128 },
          "judgment": { "type": "string", "enum": ["不符合", "部分符合"] },
          "reason": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
