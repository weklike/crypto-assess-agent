{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "citations"],
  "properties": {
    "answer": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-H]$" }
    },
    "citations": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 }
    }
  }
}
